#!/bin/sh
# tvfetch — neofetch-style system info for LG webOS TVs
# Uses cursor positioning (neofetch technique) for perfect alignment

R="\033[1;31m"
W="\033[1;37m"
N="\033[0m"
COL=32

jval() { sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$2" 2>/dev/null | head -1; }

hostname=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo "unknown")
OS_JSON="/var/run/nyx/os_info.json"
DEV_JSON="/var/run/nyx/device_info.json"

webos_ver=$(jval webos_release "$OS_JSON")
webos_build=$(jval webos_build_id "$OS_JSON")
webos_name=$(jval webos_name "$OS_JSON")
fw_ver=$(jval webos_manufacturing_version "$OS_JSON")
codename=$(jval webos_release_codename "$OS_JSON")

model=$(jval product_id "$DEV_JSON")
[ -z "$model" ] && model=$(jval modelName /var/luna/preferences/systemproperties.json 2>/dev/null)

kernel=$(uname -r 2>/dev/null)
arch=$(uname -m 2>/dev/null)

cpu=$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed "s/^ //")
[ -z "$cpu" ] && cpu=$(grep -m1 "Processor" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed "s/^ //")
cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
soc=$(grep -m1 "Hardware" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed "s/^ //")

mt=$(awk '/MemTotal/{print $2}' /proc/meminfo)
ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
mu=$(( (mt - ma) / 1024 ))
mtm=$(( mt / 1024 ))
mp=$(( mu * 100 / mtm ))

st=$(awk '/SwapTotal/{print $2}' /proc/meminfo)
sf=$(awk '/SwapFree/{print $2}' /proc/meminfo)
su=$(( (st - sf) / 1024 ))
stm=$(( st / 1024 ))
sp=$(( su * 100 / stm ))

dl=$(df -h /media 2>/dev/null | tail -1)
d_used=$(echo "$dl" | awk '{print $3}')
d_total=$(echo "$dl" | awk '{print $2}')
d_pct=$(echo "$dl" | awk '{print $5}')

usb=""
ul=$(df -h /tmp/usb/sda/sda1 2>/dev/null | tail -1)
if [ -n "$ul" ]; then
    u_used=$(echo "$ul" | awk '{print $3}')
    u_total=$(echo "$ul" | awk '{print $2}')
    u_pct=$(echo "$ul" | awk '{print $5}')
    usb="$u_used / $u_total ($u_pct)"
fi

us=$(awk '{print int($1)}' /proc/uptime)
ud=$((us / 86400)); uh=$(( (us % 86400) / 3600 )); um=$(( (us % 3600) / 60 ))
if [ "$ud" -gt 0 ]; then upt="${ud}d ${uh}h ${um}m"
elif [ "$uh" -gt 0 ]; then upt="${uh}h ${um}m"
else upt="${um}m"; fi

ip=$(ip -4 addr show wlan0 2>/dev/null | awk '/inet /{print $2}')
iface="wlan0"
if [ -z "$ip" ]; then
    ip=$(ip -4 addr show eth0 2>/dev/null | awk '/inet /{print $2}')
    iface="eth0"
fi

gpu=$(grep -m1 "mali" /proc/modules 2>/dev/null | awk '{print "Mali (" $1 ")"}')
[ -z "$gpu" ] && gpu="Mali"

sh_name=$(basename "$(readlink /proc/$$/exe 2>/dev/null || echo /bin/sh)")
procs=$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)

root_st="No"; [ "$(id -u)" = "0" ] && root_st="Yes"

hv=""
hd="/media/developer/apps/usr/palm/applications/org.webosbrew.hbchannel"
[ -f "$hd/appinfo.json" ] && hv=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$hd/appinfo.json" 2>/dev/null | head -1)

# separator
sep=""
i=0; while [ $i -lt ${#hostname} ]; do sep="${sep}-"; i=$((i+1)); done

# --- Build info lines array ---
info_count=0
add_info() {
    eval "info_${info_count}=\"\$1\""
    info_count=$((info_count + 1))
}

add_info "${W}${hostname}${N}"
add_info "${sep}"
add_info "${W}OS:${N}        $webos_name $webos_ver-$webos_build ($codename)"
add_info "${W}Firmware:${N}  $fw_ver"
add_info "${W}Model:${N}     $model"
add_info "${W}Kernel:${N}    $kernel ($arch)"
add_info "${W}SoC:${N}       $soc"
add_info "${W}CPU:${N}       $cpu ($cores)"
add_info "${W}GPU:${N}       $gpu"
add_info "${W}Memory:${N}    ${mu}MiB / ${mtm}MiB (${mp}%)"
add_info "${W}Swap:${N}      ${su}MiB / ${stm}MiB (${sp}%)"
add_info "${W}Uptime:${N}    $upt"
add_info "${W}Shell:${N}     $sh_name"
add_info "${W}Display:${N}   3840x2160 (4K UHD)"
add_info "${W}Disk:${N}      $d_used / $d_total ($d_pct)"
[ -n "$usb" ] && add_info "${W}USB:${N}       $usb"
add_info "${W}Procs:${N}     $procs"
add_info "${W}IP:${N}        $ip ($iface)"
add_info "${W}Root:${N}      $root_st"
[ -n "$hv" ] && add_info "${W}HBChannel:${N} v$hv"

# --- Logo lines ---
logo_count=0
add_logo() {
    eval "logo_${logo_count}=\"\$1\""
    logo_count=$((logo_count + 1))
}

add_logo "        ${R}████████████████${N}"
add_logo "      ${R}██${N}                ${R}██${N}"
add_logo "    ${R}██${N}    ██████████    ${R}██${N}"
add_logo "    ${R}██${N}    ██      ██    ${R}██${N}"
add_logo "    ${R}██${N}    ██      ██    ${R}██${N}"
add_logo "    ${R}██${N}    ██      ██    ${R}██${N}"
add_logo "    ${R}██${N}    ██████████    ${R}██${N}"
add_logo "      ${R}██${N}                ${R}██${N}"
add_logo "        ${R}████████████████${N}"
add_logo "           ${R}████████${N}"
add_logo "           ${R}██${N}    ${R}██${N}"
add_logo "           ${R}████████${N}"

# --- Print: logo and info side by side ---
# Use cursor column positioning for each line
max=$info_count
[ $logo_count -gt $max ] && max=$logo_count

printf "\n"
i=0
while [ $i -lt $max ]; do
    if [ $i -lt $logo_count ]; then
        eval "l=\$logo_${i}"
        printf "%b" "$l"
    fi
    printf "\033[${COL}G"
    if [ $i -lt $info_count ]; then
        eval "t=\$info_${i}"
        printf "%b" "$t"
    fi
    printf "${N}\n"
    i=$((i + 1))
done
printf "\n"
printf "\033[${COL}G\033[40m  \033[41m  \033[42m  \033[43m  \033[44m  \033[45m  \033[46m  \033[47m  ${N}\n"
printf "\n"
